{
  "name": "@powersync/node",
  "version": "1.16.1",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "description": "PowerSync - sync Postgres with SQLite in your Node.js app for offline-first and real-time data",
  "author": "JOURNEYAPPS",
  "license": "Apache-2.0",
  "homepage": "https://docs.powersync.com/",
  "repository": "github:powersync-ja/powersync-js",
  "bugs": {
    "url": "https://github.com/powersync-ja/powersync-js/issues"
  },
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "files": [
    "dist",
    "extension.json",
    "postinstall.mjs"
  ],
  "scripts": {
    "build": "tsc -b",
    "build:prod": "tsc -b --sourceMap false",
    "clean": "rm -rf dist tsconfig.tsbuildinfo dist",
    "postinstall": "node postinstall.mjs",
    "watch": "tsc -b -w"
  },
  "peerDependencies": {
    "@powersync/common": "workspace:^1.22.0",
    "better-sqlite3": "github:spinda/better-sqlite3#flexwash"
  },
  "dependencies": {
    "@powersync/common": "workspace:*",
    "async-lock": "^1.4.0",
    "bson": "^6.6.0",
    "pkg-dir": "^8.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@tsconfig/node-lts": "^22.0.1",
    "@types/async-lock": "^1.4.0",
    "@types/better-sqlite3": "github:spinda/DefinitelyTyped#flexwash&path:/types/better-sqlite3",
    "@types/ws": "^8.5.13",
    "typescript": "^5.5.3"
  },
  "keywords": [
    "data sync",
    "offline-first",
    "sqlite",
    "real-time data stream",
    "live data"
  ]
}
